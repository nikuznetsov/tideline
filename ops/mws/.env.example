# Скопируйте в ops/mws/.env и заполните. .env в git не коммитить.

# --- домен и база ---
DOMAIN=xops-tideline.online
APP_BASE_URL=https://xops-tideline.online
POSTGRES_PASSWORD=            # openssl rand -hex 24

# --- секреты приложения (прод-гвард не даст стартовать с дефолтными) ---
SECRET_KEY=                   # openssl rand -hex 32
ADMIN_EMAIL=demo@xops-tideline.online
ADMIN_PASSWORD=               # придумайте надёжный
METRICS_TOKEN=                # openssl rand -hex 24

# --- пространство по умолчанию ---
WORKSPACE_SLUG=xops
WORKSPACE_NAME=xOps

TZ=Europe/Moscow
LOG_LEVEL=INFO

# --- деплой ---
# 1 — на самом первом запуске (бэкапы ещё не настроены), потом убрать/поставить 0
SKIP_PREDEPLOY_BACKUP=1
# 1 — разово залить демо-данные, после успешного запуска ОБЯЗАТЕЛЬНО вернуть 0,
# иначе каждый передеплой перезатирает данные демо-набором
SEED_DEMO=0

# --- бэкапы (S3-совместимое хранилище, например MWS Object Storage) ---
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_ENCRYPTION_KEY=      # публичный age-ключ (age-keygen -o age.key)
