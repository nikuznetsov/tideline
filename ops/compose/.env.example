# Copy to ops/compose/.env and fill in. Never commit .env to git.

# --- domain and database ---
DOMAIN=tideline.example.com
APP_BASE_URL=https://tideline.example.com
POSTGRES_PASSWORD=change-me    # generate yourself: openssl rand -hex 24

# --- application secrets (the production guard refuses to start with defaults) ---
SECRET_KEY=change-me           # generate yourself: openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me       # pick a strong password
METRICS_TOKEN=change-me        # generate yourself: openssl rand -hex 24

# --- default workspace ---
WORKSPACE_SLUG=main
WORKSPACE_NAME="Main"

TZ=UTC
LOG_LEVEL=INFO

# --- deploy ---
# 1 — on the very first start only (backups not configured yet); then remove or set to 0
SKIP_PREDEPLOY_BACKUP=1
# 1 — load the demo data once; after a successful start you MUST set it back to 0,
# otherwise every redeploy overwrites the data with the demo set
SEED_DEMO=0

# --- backups ---
# Option 1: locally on the VM. /backups inside the container = /var/backups/tideline
# on the host (mounted in docker-compose.yml). Always copy the directory somewhere
# else — a backup next to the database does not survive the loss of the VM itself.
# BACKUP_DIR=/backups
# BACKUP_ENCRYPTION_KEY=      # public age key (age-keygen -o age.key)
# For verify_backup.py (restore check):
# VERIFY_DATABASE_URL=postgresql://tideline:<POSTGRES_PASSWORD>@db:5432/tideline
# AGE_SECRET_KEY=             # private age key (keep a copy off the VM as well!)

# Option 2: S3-compatible storage (leave BACKUP_DIR unset in that case)
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
