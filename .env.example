# --- обязательные ---
DATABASE_URL=postgresql://user:pass@host:5432/tideline   # от Railway; локально можно sqlite+aiosqlite:///./tideline.db
SECRET_KEY=замените-на-длинную-случайную-строку          # подпись cookie-сессий
ADMIN_EMAIL=lead@example.com                             # сид первого пользователя
ADMIN_PASSWORD=надёжный-пароль

# --- приложение ---
APP_BASE_URL=https://tideline.example.com
WORKSPACE_SLUG=xops
TZ=Europe/Moscow
LOG_LEVEL=INFO
SENTRY_DSN=                                              # опционально

# --- бэкапы (S3-совместимое хранилище вне Railway: R2 / B2) ---
BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=tideline-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=age1...                            # ПУБЛИЧНЫЙ age-ключ получателя
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# --- только для cron-verify и restore ---
VERIFY_DATABASE_URL=postgresql://user:pass@host:5432/postgres  # где можно создавать временные БД
AGE_SECRET_KEY=AGE-SECRET-KEY-...                        # ПРИВАТНЫЙ ключ, хранить только в секретах
