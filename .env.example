# --- required ---
DATABASE_URL=postgresql://user:pass@host:5432/tideline   # from your Postgres provider; locally sqlite+aiosqlite:///./tideline.db also works
SECRET_KEY=change-me-to-a-long-random-string             # signs session cookies; generate yourself: openssl rand -hex 32
ADMIN_EMAIL=lead@example.com                             # seeds the first user
ADMIN_PASSWORD=change-me                                 # pick a strong password

# --- application ---
APP_BASE_URL=https://tideline.example.com
WORKSPACE_SLUG=main
WORKSPACE_NAME=Main
TZ=UTC
LOG_LEVEL=INFO
SENTRY_DSN=                                              # optional
METRICS_TOKEN=                                           # when set, /metrics requires a Bearer token
SEED_DEMO=                                               # =1 → load demo data on deploy (remove afterwards!)
SKIP_PREDEPLOY_BACKUP=                                   # =1 → skip the backup before migrations (for the first deploy)

# --- backups (S3-compatible storage outside the app's hosting: R2 / B2) ---
BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=tideline-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=age1...                            # PUBLIC age key of the recipient
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# --- cron-verify and restore only ---
VERIFY_DATABASE_URL=postgresql://user:pass@host:5432/postgres  # where temporary databases may be created
AGE_SECRET_KEY=AGE-SECRET-KEY-...                        # PRIVATE key, keep only in a secrets manager
